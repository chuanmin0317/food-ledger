<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="FlPreviewTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorAccent">@color/fl_green</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/fl_green</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/fl_bg</item>
        <item name="android:navigationBarColor">@color/fl_bg</item>
        <item name="android:statusBarColor">@color/fl_bg</item>
    </style>

    <style name="FlButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="FlInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/input</item>
        <item name="android:textColor">@color/fl_ink</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
