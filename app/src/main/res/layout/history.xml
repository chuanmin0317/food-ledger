<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/fl_bg">

    <Button
        style="@style/FlButton"
        android:id="@+id/fl_date"
        android:text="@string/text_18"
        android:background="@drawable/secondary"
        android:textColor="@color/fl_green" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/text_19"
        android:textSize="24sp"
        android:textColor="@color/fl_ink" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/text_20"
        android:textSize="14sp"
        android:textColor="@color/fl_muted" />

    <LinearLayout
        android:id="@+id/fl_meals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>