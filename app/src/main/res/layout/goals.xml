<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/fl_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/text_68"
        android:textSize="24sp"
        android:textColor="@color/fl_ink" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/text_69"
        android:textSize="14sp"
        android:textColor="@color/fl_muted" />

    <!-- 每日熱量目標（kcal） -->
    <CheckBox
        android:id="@+id/fl_goal_kcal_enabled"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/text_70" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/text_71"
        android:textSize="14sp"
        android:textColor="@color/fl_ink"
        android:labelFor="@id/fl_goal_kcal" />

    <EditText
        style="@style/FlInput"
        android:id="@+id/fl_goal_kcal"
        android:inputType="numberDecimal"
        android:hint="@string/text_72"
        android:maxLength="100" />

    <!-- 每日蛋白質目標（g） -->
    <CheckBox
        android:id="@+id/fl_goal_p_enabled"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/text_74" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/text_75"
        android:textSize="14sp"
        android:textColor="@color/fl_ink"
        android:labelFor="@id/fl_goal_p" />

    <EditText
        style="@style/FlInput"
        android:id="@+id/fl_goal_p"
        android:inputType="numberDecimal"
        android:hint="@string/text_76"
        android:maxLength="100" />

    <!-- 每日碳水化合物目標（g） -->
    <CheckBox
        android:id="@+id/fl_goal_c_enabled"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/text_78" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/text_79"
        android:textSize="14sp"
        android:textColor="@color/fl_ink"
        android:labelFor="@id/fl_goal_c" />

    <EditText
        style="@style/FlInput"
        android:id="@+id/fl_goal_c"
        android:inputType="numberDecimal"
        android:hint="@string/text_80"
        android:maxLength="100" />

    <!-- 每日脂肪目標（g） -->
    <CheckBox
        android:id="@+id/fl_goal_f_enabled"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/text_82" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/text_83"
        android:textSize="14sp"
        android:textColor="@color/fl_ink"
        android:labelFor="@id/fl_goal_f" />

    <EditText
        style="@style/FlInput"
        android:id="@+id/fl_goal_f"
        android:inputType="numberDecimal"
        android:hint="@string/text_84"
        android:maxLength="100" />

    <!-- 提醒設定區塊 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/secondary">

        <Switch
            android:id="@+id/fl_reminder"
            android:showText="false"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/text_86" />

        <Button
            style="@style/FlButton"
            android:id="@+id/fl_time"
            android:text="@string/text_87"
            android:background="@drawable/secondary"
            android:textColor="@color/fl_green" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/text_88"
            android:textSize="13sp"
            android:textColor="@color/fl_ink" />
    </LinearLayout>

    <!-- 通知狀態區塊 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/amber">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/text_89"
            android:textSize="16sp"
            android:textColor="@color/fl_ink" />

        <TextView
            android:id="@+id/fl_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/text_90"
            android:textSize="15sp"
            android:textColor="@color/fl_ink" />
    </LinearLayout>

    <Button
        style="@style/FlButton"
        android:id="@+id/fl_save_goals"
        android:text="@string/text_91"
        android:background="@drawable/primary"
        android:textColor="@color/fl_white" />

</LinearLayout>